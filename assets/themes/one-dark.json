{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "One",
  "author": "Racketeer",
  "themes": [
    {
      "name": "One Dark",
      "appearance": "dark",
      "style": {
        "background": "#21252b",
        "surface.background": "#21252b",
        "elevated_surface.background": "#21252b",
        "panel.background": "#21252b",
        "editor.background": "#282c34",
        "editor.gutter.background": "#282c34",
        "editor.foreground": "#abb2bf",
        "title_bar.background": "#21252b",
        "status_bar.background": "#21252b",
        "tab_bar.background": "#21252b",
        "tab.active_background": "#282c34",
        "tab.inactive_background": "#21252b",
        "toolbar.background": "#282c34",
        "border": "#181a1f",
        "border.variant": "#181a1f",
        "border.focused": "#61afef",
        "element.background": "#3a3f4b",
        "element.hover": "#2c313a",
        "element.selected": "#3a3f4b",
        "element.active": "#3a3f4b",
        "ghost_element.hover": "#2c313a",
        "ghost_element.selected": "#3a3f4b",
        "text": "#d7dae0",
        "text.muted": "#9da5b4",
        "text.placeholder": "#5c6370",
        "text.accent": "#61afef",
        "icon": "#9da5b4",
        "icon.muted": "#5c6370",
        "icon.accent": "#61afef",
        "editor.active_line.background": "#2c313c",
        "editor.line_number": "#495162",
        "editor.active_line_number": "#abb2bf",
        "element.selection_background": "#3e4451",
        "players": [
          {
            "cursor": "#528bff",
            "background": "#528bff",
            "selection": "#3e4451"
          }
        ],
        "terminal.background": "#282c34",
        "terminal.foreground": "#abb2bf",
        "syntax": {
          "keyword": {
            "color": "#c678dd"
          },
          "function": {
            "color": "#61afef"
          },
          "variable": {
            "color": "#e06c75"
          },
          "string": {
            "color": "#98c379"
          },
          "string.escape": {
            "color": "#56b6c2"
          },
          "string.regex": {
            "color": "#56b6c2"
          },
          "number": {
            "color": "#d19a66"
          },
          "constant": {
            "color": "#d19a66"
          },
          "comment": {
            "color": "#7f848e",
            "font_style": "italic"
          },
          "punctuation.bracket": {
            "color": "#abb2bf"
          },
          "operator": {
            "color": "#56b6c2"
          },
          "variable.special": {
            "color": "#e5c07b"
          },
          "type": {
            "color": "#e5c07b"
          }
        },
        "terminal.ansi.black": "#282c34",
        "terminal.ansi.bright_black": "#5c6370",
        "terminal.ansi.red": "#e06c75",
        "terminal.ansi.bright_red": "#e06c75",
        "terminal.ansi.green": "#98c379",
        "terminal.ansi.bright_green": "#98c379",
        "terminal.ansi.yellow": "#e5c07b",
        "terminal.ansi.bright_yellow": "#e5c07b",
        "terminal.ansi.blue": "#61afef",
        "terminal.ansi.bright_blue": "#61afef",
        "terminal.ansi.magenta": "#c678dd",
        "terminal.ansi.bright_magenta": "#c678dd",
        "terminal.ansi.cyan": "#56b6c2",
        "terminal.ansi.bright_cyan": "#56b6c2",
        "terminal.ansi.white": "#abb2bf",
        "terminal.ansi.bright_white": "#ffffff"
      }
    }
  ]
}